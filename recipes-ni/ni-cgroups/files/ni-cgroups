#!/bin/bash
### BEGIN INIT INFO
# Provides:          ni-cgroups
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: Setup cgroups LabVIEW RT & assign tasks
### END INIT INFO

. /usr/share/ni-cgroups/lvrt-cgroup-version.sh
LVRT_CGROUP_VERSION=$(select_lvrt_cgroup_version "$(lvrt_installed_package)")

if [ "$LVRT_CGROUP_VERSION" -eq 1 ]; then
        /etc/init.d/ni-cgroups-v1 "$1"
else
        /etc/init.d/ni-cgroups-v2 "$1"
fi
