#!/bin/sh
# ni-firewall-apply - reconcile declarative NI firewall drop-ins with firewalld.
#
# Contract:
#   A package that needs an inbound firewalld service opened ships:
#     1. the service definition  <service>.xml  in the firewalld services dir
#        (e.g. ${libdir}/firewalld/services or /etc/firewalld/services), and
#     2. a drop-in marker file   /etc/ni/firewall/open.d/<name>
#   The marker names one or more firewalld services to open, one per line;
#   blank lines and lines starting with '#' are ignored. A marker with no
#   service lines defaults to a single service named after the marker file with
#   any leading "NN-" ordering prefix and trailing ".conf" suffix removed.
#
# Declared services are opened in the "ni-dropins" firewalld policy, which this
# package ships and which applies to the "public" and "work" zones. The policy
# lives under the firewalld system directory, so it survives
# 'firewall-offline-cmd --reset-to-defaults' (empty); the next run refills it.
#
# On each run this hook:
#   * opens every service named by a current marker (idempotent), and
#   * closes every service it opened on a previous run whose marker (or service
#     line) has since been removed.
# It reuses the ni-firewall-open / ni-firewall-close helper, so all offline/live
# and permanent/runtime handling is shared. It only ever closes services it
# recorded in its own state file, so services opened outside this mechanism
# (such as the core NI services opened in the default zone by the
# ni-firewalld-servicedefs postinst) are never disturbed.
#
# Earlier versions opened drop-ins in the default zone and kept a state file
# without a header. On the first run with such a state file, the services it
# lists are closed in the default zone; services that are still declared are
# then opened in the policy as usual.

set -u
# Service names are literals; disable globbing so unquoted list expansions
# (for svc in $desired, in_list ... $desired) can't match stray filenames.
set -f

OPEN_D=${NI_FIREWALL_OPEN_D:-/etc/ni/firewall/open.d}
STATE_DIR=${NI_FIREWALL_STATE_DIR:-/var/lib/ni/firewall}
STATE_FILE=$STATE_DIR/applied
LOCK_FILE=$STATE_DIR/apply.lock
POLICY=ni-dropins
STATE_HEADER="# ni-firewall-apply state v2"

prog=${0##*/}

if ! mkdir -p "$STATE_DIR"; then
	echo "$prog: cannot create state directory '$STATE_DIR'" >&2
	exit 1
fi

# Serialize concurrent runs (boot plus a later package operation). Non-blocking:
# if another run already holds the lock it will do the reconciliation, so just
# exit cleanly rather than stacking a second pass. flock is required (RDEPENDS);
# a missing flock or an unopenable lock file is a hard error, distinct from the
# lock being held by another run.
if ! command -v flock >/dev/null 2>&1; then
	echo "$prog: flock not found; refusing to run without locking" >&2
	exit 1
fi
if ! touch "$LOCK_FILE" 2>/dev/null; then
	echo "$prog: cannot create lock file '$LOCK_FILE'" >&2
	exit 1
fi
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
	echo "$prog: another apply run is in progress; skipping" >&2
	exit 0
fi

# in_list <item> [list...] - return 0 if <item> is present in the argument list.
in_list() {
	item=$1
	shift
	for e in "$@"; do
		[ "$e" = "$item" ] && return 0
	done
	return 1
}

# Build the desired service set from the current markers.
desired=""
if [ -d "$OPEN_D" ]; then
	# Enable globbing only to list the marker files, then disable it again.
	set +f
	set -- "$OPEN_D"/*
	set -f
	for marker in "$@"; do
		[ -f "$marker" ] || continue
		got_line=0
		while IFS= read -r line || [ -n "$line" ]; do
			# Drop inline/whole-line comments, then all whitespace.
			svc=$(printf '%s' "${line%%#*}" | tr -d '[:space:]')
			[ -n "$svc" ] || continue
			got_line=1
			in_list "$svc" $desired || desired="$desired $svc"
		done < "$marker"
		# Empty marker: derive the service from the file name.
		if [ "$got_line" = 0 ]; then
			svc=${marker##*/}
			svc=${svc%.conf}
			svc=${svc#[0-9][0-9]-}
			in_list "$svc" $desired || desired="$desired $svc"
		fi
	done
fi

# Services opened by the previous run. A state file without the header comes
# from a version that opened drop-ins in the default zone.
previous=""
legacy=""
if [ -f "$STATE_FILE" ]; then
	format=legacy
	while IFS= read -r svc || [ -n "$svc" ]; do
		if [ "$svc" = "$STATE_HEADER" ]; then
			format=current
			continue
		fi
		case $svc in ''|'#'*) continue ;; esac
		previous="$previous $svc"
	done < "$STATE_FILE"
	if [ "$format" = legacy ]; then
		legacy=$previous
		previous=""
	fi
fi

# Services enabled in the policy's permanent config, and in the running config
# when firewalld runs (firewall-cmd exits 252 when it does not; offline there
# is only the permanent config). Each firewall tool call takes about a
# second on a cRIO, so read the state once instead of querying every service.
read_live() {
	enabled=$(firewall-cmd --permanent --policy="$POLICY" --list-services 2>/dev/null) ||
		return
	running=$(firewall-cmd --policy="$POLICY" --list-services 2>/dev/null)
}
list_enabled() {
	read_live
	case $? in
	0) return 0 ;;
	252) ;;
	# INVALID_POLICY: the daemon was started before this package installed the
	# policy. It watches its config directories, so the permanent config may
	# already know the policy, but it loads it into the running config only at
	# start/reload.
	140)
		echo "$prog: reloading firewalld to load policy '$POLICY'"
		firewall-cmd --reload >/dev/null 2>&1 || return 1
		read_live
		return
		;;
	# Without D-Bus firewall-cmd fails with DBUS_ERROR, not 252.
	*) ! firewall-cmd --state >/dev/null 2>&1 || return 1 ;;
	esac
	enabled=$(firewall-offline-cmd --policy="$POLICY" --list-services 2>/dev/null) || return 1
	running=$enabled
}
if ! list_enabled; then
	echo "$prog: could not read firewalld policy '$POLICY'" >&2
	exit 1
fi

# Migrate: take the services an earlier version opened out of the default zone.
# Those still declared are reopened in the policy below. This runs only once
# the policy is readable, so a service is never closed in the zone without
# being reopened in the policy. On failure leave the state untouched, so the
# next run retries the migration.
if [ -n "$legacy" ]; then
	echo "$prog: moving drop-ins from the default zone to policy '$POLICY'"
	if ! ni-firewall-close $legacy; then
		echo "$prog: could not close drop-ins in the default zone; will retry" >&2
		exit 1
	fi
fi

rc=0

# Open desired services missing from either config, and close services we
# opened before whose marker is gone while either config still has them. Only
# touch what differs, in one helper call each.
to_open=""
for svc in $desired; do
	in_list "$svc" $enabled && in_list "$svc" $running || to_open="$to_open $svc"
done
to_close=""
for svc in $previous; do
	in_list "$svc" $desired && continue
	in_list "$svc" $enabled || in_list "$svc" $running && to_close="$to_close $svc"
done
[ -z "$to_open" ] || ni-firewall-open --policy="$POLICY" $to_open || rc=1
[ -z "$to_close" ] || ni-firewall-close --policy="$POLICY" $to_close || rc=1
before=$enabled

# A desired service is ours if we opened it on a previous run or this run
# enabled it; one that something else had already enabled is never ours, so we
# never close, for example, the core NI services. A service stays ours while its
# reopen or close fails, so the next run retries it instead of leaking the rule.
applied=""
if [ -n "$to_open$to_close" ] && ! list_enabled; then
	echo "$prog: could not re-read firewalld policy '$POLICY'" >&2
	rc=1
	applied=$previous
	for svc in $to_open; do
		in_list "$svc" $before $applied || applied="$applied $svc"
	done
else
	for svc in $desired; do
		if in_list "$svc" $previous ||
		    { in_list "$svc" $enabled && ! in_list "$svc" $before; }; then
			applied="$applied $svc"
		fi
	done
	for svc in $previous; do
		in_list "$svc" $desired && continue
		if in_list "$svc" $enabled || in_list "$svc" $running; then
			rc=1
			applied="$applied $svc"
		fi
	done
fi

# Persist the set we opened (a header, then one service per line) via a temp
# file + rename so the state is never left half-written if the hook is
# interrupted. Treat write failures as errors so a silently-lost state can't
# corrupt later reconciles.
tmp=$STATE_FILE.tmp
if ! ( echo "$STATE_HEADER" > "$tmp" ) 2>/dev/null; then
	echo "$prog: cannot write state file '$tmp'" >&2
	rc=1
else
	write_ok=1
	for svc in $applied; do
		echo "$svc" >> "$tmp" || write_ok=0
	done
	if [ "$write_ok" = 1 ]; then
		mv "$tmp" "$STATE_FILE" || rc=1
	else
		echo "$prog: failed to write state; keeping previous state" >&2
		rm -f "$tmp"
		rc=1
	fi
fi

exit $rc
