[Unit]
Description=NI Persistent Logs Configuration Utility
DefaultDependencies=no
Requires=mountconfig.service
After=local-fs.target mountconfig.service
Before=systemd-tmpfiles-setup.service systemd-journald.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/systemd/scripts/ni-configpersistentlogs

[Install]
WantedBy=sysinit.target
