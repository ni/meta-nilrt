From e728020f6642cac52050de204f3f85aa94b064c3 Mon Sep 17 00:00:00 2001
From: Yunguo Wei <yunguo.wei@windriver.com>
Date: Sat, 12 Aug 2023 13:53:24 +0800
Subject: [PATCH] grub-efi: support passing a buffer to be verified

Previously, GRUB passes a file path/name to SELoader for verification
request. That is working if kernel/initrd images are in the same
EFI partition as GRUB.

But for the scenario kernel/initrd images are in a different partition,
since seloader can not access file accross file system, GRUB will always
get a verfication failure when booting kernel and initrd, although they
are correctly signed.

So we add the capability to GRUB/SELoader to verify a buffer, rather
than passing a file path only.

Verify initrds against the bytes already loaded into their destination buffer,
and fail if secure state or the MOK2 verification protocol is unavailable.

Return a memory-backed file containing the authenticated bytes for configs,
kernels and buffered-file consumers. Never verify a disposable copy and then
reopen the boot medium to parse or load potentially different contents.

Upstream-Status: Inappropriate [embedded specific]

Signed-off-by: Yunguo Wei <yunguo.wei@windriver.com>
Signed-off-by: Yi Zhao <yi.zhao@windriver.com>
---
 grub-core/lib/efi/mok2verify.c | 234 +++++++++++++++++++++++++++++++++++++++++
 grub-core/loader/i386/linux.c |  56 +---------
 grub-core/loader/linux.c      |   5 +-
 grub-core/normal/main.c       |  25 ++---
 include/grub/efi/mok2verify.h |  12 +++
 5 files changed, 262 insertions(+), 70 deletions(-)

diff --git a/grub-core/lib/efi/mok2verify.c b/grub-core/lib/efi/mok2verify.c
index 2e5285c..e819f12 100644
--- a/grub-core/lib/efi/mok2verify.c
+++ b/grub-core/lib/efi/mok2verify.c
@@ -55,6 +55,7 @@ typedef grub_efi_status_t
 typedef grub_efi_status_t
 (__grub_efi_api *grub_efi_mok2_verify_file_buffer) (efi_mok2_verify_protocol_t *this,
 				     void **data, grub_efi_uintn_t *data_size,
+				     void *sigdata, grub_efi_uintn_t sigdata_size,
 				     const grub_efi_char16_t *path);

 typedef grub_efi_status_t
@@ -112,6 +113,239 @@ grub_is_locked (void)

 #pragma GCC diagnostic ignored "-Wvla"

+grub_err_t
+grub_verify_buffer (const char *path, void *data, grub_ssize_t data_size)
+{
+  grub_file_t sigfile = NULL;
+  void *verified_data = data;
+  grub_ssize_t verified_size = data_size;
+  grub_ssize_t sigdata_size;
+  void *sigdata = NULL;
+  char *sigpath = NULL;
+  int secured;
+
+  secured = grub_is_secured ();
+  if (grub_errno != GRUB_ERR_NONE)
+    return grub_errno;
+  if (secured != 1)
+    return GRUB_ERR_NONE;
+
+  grub_dprintf ("linux", "Verifying file %s\n", path);
+
+  /*By now only supported p7b file veryfing*/
+  sigpath = grub_xasprintf("%s.p7b", path);
+  if (!sigpath)
+    return grub_errno;
+  sigfile = grub_file_open (sigpath, GRUB_FILE_TYPE_SIGNATURE);
+  if (!sigfile) {
+    grub_error (GRUB_ERR_BAD_OS, N_("Cannot find the signature file %s"),
+                    sigpath);
+    goto fail;
+  }
+
+  sigdata_size = grub_file_size (sigfile);
+  sigdata = grub_malloc (sigdata_size);
+  if (!sigdata)
+    goto fail;
+
+  if (grub_file_read (sigfile, sigdata, sigdata_size) != sigdata_size)
+    {
+      if (!grub_errno)
+        grub_error (GRUB_ERR_BAD_OS, N_("Cannot read the signature file %s"),
+                    sigpath);
+      goto fail;
+    }
+
+  grub_errno = grub_verify_file_buffer (&verified_data, &verified_size,
+                                       sigdata, sigdata_size, path);
+  if (grub_errno == GRUB_ERR_NONE &&
+      (verified_data != data || verified_size != data_size))
+    grub_error (GRUB_ERR_ACCESS_DENIED, N_("verified file %s changed size or address"),
+                path);
+
+  if (grub_errno == GRUB_ERR_NONE)
+    grub_dprintf ("linux", "file %s verified\n", path);
+  else
+    grub_error (grub_errno, N_("failed to verify file %s"), path);
+
+fail:
+  if (sigdata)
+    grub_free (sigdata);
+  grub_free (sigpath);
+  if (sigfile)
+    grub_file_close (sigfile);
+
+  return grub_errno;
+}
+
+static grub_ssize_t
+grub_verified_read (grub_file_t file, char *buf, grub_size_t len)
+{
+  grub_memcpy (buf, (char *) file->data + file->offset, len);
+  return len;
+}
+
+static grub_err_t
+grub_verified_close (grub_file_t file)
+{
+  grub_free (file->data);
+  return grub_errno;
+}
+
+static struct grub_fs grub_verified_fs =
+  {
+    .name = "mok2_verified",
+    .fs_read = grub_verified_read,
+    .fs_close = grub_verified_close
+  };
+
+grub_file_t
+grub_verify_file_open (const char *path, enum grub_file_type type)
+{
+  grub_file_t file, verified = NULL;
+  grub_file_filter_id_t filter;
+  grub_ssize_t data_size;
+  void *data = NULL;
+  int secured;
+
+  secured = grub_is_secured ();
+  if (grub_errno != GRUB_ERR_NONE)
+    return NULL;
+  if (secured != 1)
+    return grub_file_open (path, type);
+
+  /* Authenticate stored bytes before decompression, as grub_file_open does. */
+  file = grub_file_open (path, type | GRUB_FILE_TYPE_NO_DECOMPRESS);
+  if (!file)
+    return NULL;
+
+  if (grub_file_size (file) >> (sizeof (grub_ssize_t) * GRUB_CHAR_BIT - 1))
+    {
+      grub_error (GRUB_ERR_NOT_IMPLEMENTED_YET,
+                  N_("big file signature isn't implemented yet"));
+      goto fail;
+    }
+  data_size = grub_file_size (file);
+  data = grub_malloc (data_size ? data_size : 1);
+  if (!data)
+    goto fail;
+
+  if (grub_file_read (file, data, data_size) != data_size)
+    {
+      if (!grub_errno)
+        grub_error (GRUB_ERR_BAD_OS, N_("premature end of file %s"), path);
+      goto fail;
+    }
+
+  if (grub_verify_buffer (path, data, data_size) != GRUB_ERR_NONE)
+    goto fail;
+
+  verified = grub_zalloc (sizeof (*verified));
+  if (!verified)
+    goto fail;
+  verified->name = grub_strdup (path);
+  if (!verified->name)
+    {
+      grub_free (verified);
+      verified = NULL;
+      goto fail;
+    }
+  verified->fs = &grub_verified_fs;
+  verified->size = data_size;
+  verified->data = data;
+  data = NULL;
+
+fail:
+  grub_free (data);
+  grub_file_close (file);
+  if (!verified)
+    return NULL;
+
+  for (filter = GRUB_FILE_FILTER_COMPRESSION_FIRST;
+       filter <= GRUB_FILE_FILTER_COMPRESSION_LAST; filter++)
+    if (grub_file_filters[filter])
+      {
+        grub_file_t filtered = grub_file_filters[filter] (verified, type);
+        if (!filtered)
+          {
+            grub_file_close (verified);
+            return NULL;
+          }
+        if (filtered != verified)
+          /* Decompression wrappers leave name ownership with their parent. */
+          filtered->name = verified->name;
+        verified = filtered;
+      }
+  return verified;
+}
+
+grub_err_t
+grub_verify_file_buffer ( void **data, grub_ssize_t *data_size,
+                   void *sigdata, grub_ssize_t sigdata_size, const char *path)
+{
+  efi_mok2_verify_protocol_t *mok2;
+  grub_efi_status_t status;
+  grub_efi_uintn_t verified_size = *data_size;
+  grub_efi_char16_t *p;
+  grub_size_t len = grub_strlen (path);
+  grub_efi_char16_t file_path[(len + 1) * GRUB_MAX_UTF16_PER_UTF8];
+  const char *root;
+  const char *real_path;
+
+  mok2 = grub_efi_locate_protocol (&grub_efi_mok2_verify_protoco_guid, 0);
+  if (!mok2)
+    {
+      grub_dprintf ("mok2verify", "unable to load mok2 verify protocol\n");
+      return grub_error (GRUB_ERR_ACCESS_DENIED, N_("MOK2 verify protocol unavailable"));
+    }
+
+  grub_dprintf ("mok2verify", "attempting to verify the file %s ...\n", path);
+
+  real_path = path;
+  root = grub_env_get ("root");
+  if (root)
+    {
+      char *pattern;
+
+      pattern = grub_xasprintf ("(%s)", root);
+      if (!pattern)
+        return grub_errno;
+
+      if (grub_strstr (path, pattern) == path)
+        {
+          real_path = path + grub_strlen (pattern);
+          len -= grub_strlen (pattern);
+        }
+
+      grub_free (pattern);
+    }
+
+  len = grub_utf8_to_utf16 (file_path, len * GRUB_MAX_UTF16_PER_UTF8,
+                            (const grub_uint8_t *) real_path, len, 0);
+  file_path[len] = 0;
+  for (p = file_path; p < file_path + len; ++p)
+    if (*p == '/')
+      *p = '\\';
+
+  status = mok2->verify_file_buffer(mok2, data, &verified_size, sigdata, sigdata_size, file_path);
+  if (status != GRUB_EFI_SUCCESS)
+    {
+        grub_printf ("failed to verify file %s (err: 0x%lx)\n",
+                       path, (long)status);
+
+        return grub_error (GRUB_ERR_ACCESS_DENIED, "the file %s is not verified",
+                             path);
+    }
+
+  if (verified_size > GRUB_SSIZE_MAX)
+    return grub_error (GRUB_ERR_ACCESS_DENIED, N_("invalid verified buffer size"));
+  *data_size = verified_size;
+
+  grub_dprintf ("mok2verify", "succeeded to verify file %s\n", path);
+
+  return GRUB_ERR_NONE;
+}
+
 grub_err_t
 grub_verify_file (const char *path)
 {
diff --git a/grub-core/loader/i386/linux.c b/grub-core/loader/i386/linux.c
index cda550c..31d430d 100644
--- a/grub-core/loader/i386/linux.c
+++ b/grub-core/loader/i386/linux.c
@@ -674,55 +674,6 @@ grub_linux_unload (void)
   return GRUB_ERR_NONE;
 }

-#ifdef GRUB_MACHINE_EFI
-static grub_err_t
-grub_verify_linux (const char *path, enum grub_file_type type)
-{
-  grub_file_t file;
-  grub_ssize_t size;
-  grub_uint8_t *buf = NULL;
-
-  grub_dprintf ("linux", "Verifying kernel %s\n", path);
-
-  file = grub_file_open (path, type);
-  if (!file)
-    return grub_errno;
-
-  size = grub_file_size (file);
-
-  buf = grub_malloc (size);
-  if (!buf)
-    goto fail;
-
-  if (grub_file_read (file, buf, size) != size)
-    {
-      if (!grub_errno)
-        grub_error (GRUB_ERR_BAD_OS, N_("premature end of kernel file %s"),
-                    path);
-      goto fail;
-    }
-
-  if (grub_verify_file (path) == GRUB_ERR_NONE)
-    grub_dprintf ("linux", "kernel %s verified\n", path);
-  else
-    grub_error (grub_errno, N_("failed to verify kernel %s"), path);
-
-fail:
-  if (buf)
-    grub_free (buf);
-
-  grub_file_close (file);
-
-  return grub_errno;
-}
-#else
-static grub_err_t
-grub_verify_linux (const char *path, enum grub_file_type type)
-{
-  return GRUB_ERR_NONE;
-}
-#endif
-
 static grub_err_t
 grub_cmd_linux (grub_command_t cmd __attribute__ ((unused)),
 		int argc, char *argv[])
@@ -745,10 +696,11 @@ grub_cmd_linux (grub_command_t cmd __attribute__ ((unused)),
       goto fail;
     }

-  if (grub_verify_linux (argv[0], GRUB_FILE_TYPE_LINUX_KERNEL))
-    goto fail;
-
+#ifdef GRUB_MACHINE_EFI
+  file = grub_verify_file_open (argv[0], GRUB_FILE_TYPE_LINUX_KERNEL);
+#else
   file = grub_file_open (argv[0], GRUB_FILE_TYPE_LINUX_KERNEL);
+#endif
   if (! file)
     goto fail;

diff --git a/grub-core/loader/linux.c b/grub-core/loader/linux.c
index 09ce5c1..0523c59 100644
--- a/grub-core/loader/linux.c
+++ b/grub-core/loader/linux.c
@@ -343,10 +343,7 @@ grub_initrd_load (struct grub_linux_initrd_context *initrd_ctx,
       grub_dprintf ("linux", "Verifying initrd %s, addr=0x%lx, size=0x%lx\n",
 		    initrd_ctx->components[i].file->name, (unsigned long) ptr, (unsigned long) cursize);

-      /*
-       * XXX: use grub_verify_file_buffer (initrd_ctx->components[i].file->name, ptr, cursize) in future
-       */
-      err = grub_verify_file (initrd_ctx->components[i].file->name);
+      err = grub_verify_buffer (initrd_ctx->components[i].file->name, ptr, cursize);
       if (err == GRUB_ERR_NONE)
 	{
 	  grub_dprintf ("linux", "initrd %s verified\n", initrd_ctx->components[i].file->name);
diff --git a/grub-core/normal/main.c b/grub-core/normal/main.c
index f688a54..7c94740 100644
--- a/grub-core/normal/main.c
+++ b/grub-core/normal/main.c
@@ -133,7 +133,18 @@ read_config_file (const char *config)
     }

   /* Try to open the config file.  */
+#ifdef GRUB_MACHINE_EFI
+  rawfile = grub_verify_file_open (config, GRUB_FILE_TYPE_CONFIG);
+  if (!rawfile && grub_is_secured () != 0)
+    {
+      grub_error (grub_errno, "Security Violation: grub.cfg failed to load");
+      grub_print_error ();
+      grub_halt ();
+      return 0;
+    }
+#else
   rawfile = grub_file_open (config, GRUB_FILE_TYPE_CONFIG);
+#endif
   if (! rawfile)
     return 0;

@@ -298,20 +309,6 @@ grub_normal_execute (const char *config, int nested, int batch)

   if (config)
     {
-#ifdef GRUB_MACHINE_EFI
-      grub_err_t err;
-
-      err = grub_verify_file (config);
-      if (err != GRUB_ERR_NONE)
-	{
-	  grub_error (err, "Security Violation: grub.cfg failed to load");
-	  grub_print_error ();
-
-	  /* System halt. */
-	  grub_halt();
-	}
-#endif
-
       menu = read_config_file (config);

       /* Ignore any error.  */
diff --git a/include/grub/efi/mok2verify.h b/include/grub/efi/mok2verify.h
index 98ef2d4..0b02f2c 100644
--- a/include/grub/efi/mok2verify.h
+++ b/include/grub/efi/mok2verify.h
@@ -32,6 +32,8 @@
 #define GRUB_EFI_MOK2_VERIFY_HEADER 1

 #include <grub/types.h>
+#include <grub/efi/api.h>
+#include <grub/file.h>

 int
 EXPORT_FUNC (grub_is_secured) (void);
@@ -45,4 +47,14 @@ EXPORT_FUNC (grub_is_unlockable) (void);
 grub_err_t
 EXPORT_FUNC (grub_verify_file) (const char *path);

+grub_file_t
+EXPORT_FUNC (grub_verify_file_open) (const char *path, enum grub_file_type type);
+
+grub_err_t
+EXPORT_FUNC (grub_verify_buffer) (const char *path, void *data, grub_ssize_t data_size);
+
+grub_err_t
+EXPORT_FUNC (grub_verify_file_buffer) ( void **data, grub_ssize_t *data_size,
+                   void *sigdata, grub_ssize_t sigdata_size, const char *path);
+
 #endif	/* ! GRUB_EFI_MOK2_VERIFY_HEADER */
