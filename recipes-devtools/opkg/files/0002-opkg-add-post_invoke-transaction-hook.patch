@@ -0,0 +1,80 @@
+#! /usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Verifies post_invoke security/robustness behaviour:
+#   - a group/world-writable hook is skipped (not executed),
+#   - a hook that exits non-zero is still run but does not fail opkg,
+#   - a later hook still runs after an earlier hook fails.
+#
+
+import os
+import opk, cfg, opkgcl
+
+opk.regress_init()
+# post_invoke hooks are skipped for offline roots, so drive opkg online.
+opkgcl.use_online_root()
+
+TEST_LOG = os.path.join(cfg.offline_root, "post_invoke_sec.log")
+HOOK_DIR = os.path.join(cfg.offline_root, "post_invoke.d")
+
+
+def readFile(path):
+    try:
+        with open(path, 'r') as f:
+            return f.read()
+    except IOError:
+        return ''
+
+
+def rmFile(path):
+    try:
+        os.remove(path)
+    except OSError:
+        pass
+
+
+def write_hook(name, body, mode):
+    path = os.path.join(HOOK_DIR, name)
+    with open(path, 'w') as f:
+        f.write(body)
+    os.chmod(path, mode)
+
+
+# The drop-in dir must itself be trusted (owned by us, not group/world-writable).
+os.makedirs(HOOK_DIR)
+os.chmod(HOOK_DIR, 0o755)
+
+# 10-ok: normal, trusted hook -> must run.
+write_hook('10-ok', "#!/bin/sh\necho ok >> '%s'\n" % TEST_LOG, 0o755)
+# 20-writable: world-writable -> must be SKIPPED even though executable.
+write_hook('20-writable', "#!/bin/sh\necho evil >> '%s'\n" % TEST_LOG, 0o757)
+# 30-fail: trusted but exits non-zero -> must run (and be logged), must NOT
+# fail opkg, and must NOT prevent later hooks.
+write_hook('30-fail', "#!/bin/sh\necho fail >> '%s'\nexit 1\n" % TEST_LOG, 0o755)
+# 40-after: proves execution continues past a failed hook.
+write_hook('40-after', "#!/bin/sh\necho after >> '%s'\n" % TEST_LOG, 0o755)
+
+sysconfdir = os.environ['SYSCONFDIR']
+with open('%s/opkg/opkg.conf' % (cfg.offline_root + sysconfdir), 'a') as f:
+    f.write('option post_invoke %s\n' % HOOK_DIR)
+
+o = opk.OpkGroup()
+o.add(Package="a")
+o.write_opk()
+o.write_list()
+opkgcl.update()
+
+rmFile(TEST_LOG)
+rc = opkgcl.install("a")
+if rc != 0:
+    opk.fail("opkg install returned %d; a hook failure must not fail opkg" % rc)
+if not opkgcl.is_installed("a"):
+    opk.fail("Package 'a' installed but reports as not installed.")
+
+log = readFile(TEST_LOG)
+if 'evil' in log:
+    opk.fail("group/world-writable hook was executed (should be skipped): %r"
+             % log)
+if log != 'ok\nfail\nafter\n':
+    opk.fail("unexpected hook execution/order: %r (expected 'ok\\nfail\\nafter\\n')"
+             % log)
diff --git a/tests/core/48_post_invoke_timeout.py b/tests/core/48_post_invoke_timeout.py
new file mode 100644
index 0000000..3e99316
--- /dev/null
+++ b/tests/core/48_post_invoke_timeout.py
@@ -0,0 +1,100 @@
+#! /usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Verifies post_invoke_timeout: a hook that runs longer than the configured
+# limit is terminated, does not fail opkg (best-effort), and does not prevent
+# a later hook from running.
+#
+
+import os
+import time
+import opk, cfg, opkgcl
+
+opk.regress_init()
+# post_invoke hooks are skipped for offline roots, so drive opkg online.
+opkgcl.use_online_root()
+
+TEST_LOG = os.path.join(cfg.offline_root, "post_invoke_timeout.log")
+HOOK_DIR = os.path.join(cfg.offline_root, "post_invoke.d")
+
+
+def readFile(path):
+    try:
+        with open(path, 'r') as f:
+            return f.read()
+    except IOError:
+        return ''
+
+
+def write_hook(name, body):
+    path = os.path.join(HOOK_DIR, name)
+    with open(path, 'w') as f:
+        f.write(body)
+    os.chmod(path, 0o755)
+
+
+os.makedirs(HOOK_DIR)
+os.chmod(HOOK_DIR, 0o755)
+
+# The hook leader exits on SIGTERM, but its child ignores SIGTERM and keeps
+# writing. The timeout implementation must still SIGKILL the whole group.
+write_hook('10-hang',
+           "#!/bin/sh\n"
+           "(trap '' TERM; while :; do echo child >> '%s'; sleep 0.1; done) &\n"
+           "trap 'exit 0' TERM\n"
+           "while :; do sleep 1; done\n" % TEST_LOG)
+# 20-after proves execution continues and detects a surviving child.
+write_hook('20-after',
+           "#!/bin/sh\n"
+           "before=$(grep -c '^child$' '%s' || true)\n"
+           "sleep 0.5\n"
+           "after=$(grep -c '^child$' '%s' || true)\n"
+           "[ \"$before\" = \"$after\" ] || echo child-survived >> '%s'\n"
+           "echo after >> '%s'\n"
+           % (TEST_LOG, TEST_LOG, TEST_LOG, TEST_LOG))
+
+sysconfdir = os.environ['SYSCONFDIR']
+with open('%s/opkg/opkg.conf' % (cfg.offline_root + sysconfdir), 'a') as f:
+    f.write('option post_invoke %s\n' % HOOK_DIR)
+    f.write('option post_invoke_timeout 1\n')
+
+o = opk.OpkGroup()
+o.add(Package="a")
+o.write_opk()
+o.write_list()
+opkgcl.update()
+
+start = time.time()
+rc = opkgcl.install("a")
+elapsed = time.time() - start
+
+if rc != 0:
+    opk.fail("opkg install returned %d; a timed-out hook must not fail opkg" % rc)
+if elapsed > 20:
+    opk.fail("hook was not terminated by post_invoke_timeout (took %.1fs)"
+             % elapsed)
+
+log = readFile(TEST_LOG)
+if 'child-survived' in log:
+    opk.fail("timed-out hook left a child running: %r" % log)
+if 'after' not in log:
+    opk.fail("later hook did not run after a timed-out hook: %r" % log)
+
+# A timeout whose millisecond value exceeds 32 bits must not wrap into a tiny
+# limit: a hook that runs for two seconds has to finish normally.
+for name in ('10-hang', '20-after'):
+    os.remove(os.path.join(HOOK_DIR, name))
+write_hook('30-slow', "#!/bin/sh\nsleep 2\necho slow-done >> '%s'\n" % TEST_LOG)
+conf = '%s/opkg/opkg.conf' % (cfg.offline_root + sysconfdir)
+with open(conf) as f:
+    text = f.read().replace('option post_invoke_timeout 1\n',
+                            'option post_invoke_timeout 4294968\n')
+with open(conf, 'w') as f:
+    f.write(text)
+open(TEST_LOG, 'w').close()
+rc = opkgcl.remove("a")
+if rc != 0:
+    opk.fail("opkg remove returned %d" % rc)
+if readFile(TEST_LOG) != 'slow-done\n':
+    opk.fail("hook was cut short with a large post_invoke_timeout: %r"
+             % readFile(TEST_LOG))
