+/*
+ * Run the post_invoke hook after a successful, state-changing transaction.
+ *
+ * opkg_config->post_invoke may name either a single executable or a directory
+ * of executables (a "drop-in" directory).  Directory entries are run in
+ * lexical order.  A hook that fails is logged but does not change opkg's exit
+ * status, since the transaction itself has already succeeded.
+ */
+static void run_post_invoke(void)
+{
+    const char *hook = opkg_config->post_invoke;
+    struct stat st;
+
+    if (!hook || !hook[0])
+        return;
+
+    if (stat(hook, &st) != 0) {
+        opkg_msg(NOTICE, "post_invoke hook %s not found; skipping.\n", hook);
+        return;
+    }
+
+    if (S_ISDIR(st.st_mode)) {
+        struct dirent **names;
+        int n, i;
+
+        n = scandir(hook, &names, NULL, alphasort);
+        if (n < 0) {
+            opkg_perror(ERROR, "Failed to scan post_invoke dir %s", hook);
+            return;
+        }
+        for (i = 0; i < n; i++) {
+            char *path;
+            struct stat est;
+
+            if (names[i]->d_name[0] == '.') {
+                free(names[i]);
+                continue;
+            }
+            sprintf_alloc(&path, "%s/%s", hook, names[i]->d_name);
+            if (stat(path, &est) == 0 && S_ISREG(est.st_mode)
+                    && access(path, X_OK) == 0) {
+                const char *argv[] = { path, NULL };
+                opkg_msg(INFO, "Running post_invoke hook %s\n", path);
+                xsystem(argv);
+            }
+            free(path);
+            free(names[i]);
+        }
+        free(names);
+    } else if (S_ISREG(st.st_mode) && access(hook, X_OK) == 0) {
+        const char *argv[] = { hook, NULL };
+        opkg_msg(INFO, "Running post_invoke hook %s\n", hook);
+        xsystem(argv);
+    } else {
+        opkg_msg(NOTICE, "post_invoke hook %s is not executable; skipping.\n",
+                 hook);
+    }
+}
+
 int main(int argc, char *argv[])
 {
     int opts, err = -1;
@@ -542,6 +607,11 @@ int main(int argc, char *argv[])
 
     err = opkg_cmd_exec(cmd, argc - opts, (const char **)(argv + opts));
 
+    /* Fire the post_invoke hook only once per invocation, and only when the
+     * transaction actually changed state and was not a dry-run. */
+    if (err == 0 && opkg_state_changed && !opkg_config->noaction)
+        run_post_invoke();
+
     opkg_download_cleanup();
  err1:
     opkg_conf_deinit();
