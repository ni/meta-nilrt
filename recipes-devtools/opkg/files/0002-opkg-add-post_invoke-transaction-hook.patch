+++ b/tests/core/49_post_invoke_path.py
@@ -0,0 +1,118 @@
+#! /usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Verifies post_invoke path hardening against symlink and pathname
+# replacement attacks:
+#   - a drop-in that is a symlink is skipped, even to a trusted executable,
+#   - a hook directory configured through a symlink is not used,
+#   - a hook directory below a directory another user can write to (and that
+#     is not sticky) is not used, since that user could swap it,
+#   - a trusted hook directory still runs its hooks.
+#
+
+import os
+import opk, cfg, opkgcl
+
+opk.regress_init()
+# post_invoke hooks are skipped for offline roots, so drive opkg online.
+opkgcl.use_online_root()
+
+TEST_LOG = os.path.join(cfg.offline_root, "post_invoke_path.log")
+CONF = '%s/opkg/opkg.conf' % (cfg.offline_root + os.environ['SYSCONFDIR'])
+with open(CONF) as f:
+    BASE_CONF = f.read()
+
+
+def readFile(path):
+    try:
+        with open(path, 'r') as f:
+            return f.read()
+    except IOError:
+        return ''
+
+
+def rmFile(path):
+    try:
+        os.remove(path)
+    except OSError:
+        pass
+
+
+def make_hook_dir(path, mode=0o755):
+    os.makedirs(path)
+    os.chmod(path, mode)
+
+
+def write_hook(path, tag):
+    with open(path, 'w') as f:
+        f.write("#!/bin/sh\necho %s >> '%s'\n" % (tag, TEST_LOG))
+    os.chmod(path, 0o755)
+
+
+def use_hook(path):
+    with open(CONF, 'w') as f:
+        f.write(BASE_CONF)
+        f.write('option post_invoke %s\n' % path)
+
+
+def cycle():
+    """Install then remove 'a'; return what the hooks logged."""
+    rmFile(TEST_LOG)
+    opkgcl.install("a")
+    if not opkgcl.is_installed("a"):
+        opk.fail("Package 'a' failed to install.")
+    opkgcl.remove("a")
+    if opkgcl.is_installed("a"):
+        opk.fail("Package 'a' failed to remove.")
+    return readFile(TEST_LOG)
+
+
+o = opk.OpkGroup()
+o.add(Package="a")
+o.write_opk()
+o.write_list()
+opkgcl.update()
+
+# A trusted executable outside the hook directory, reachable only via symlink.
+REAL = os.path.join(cfg.offline_root, "real")
+make_hook_dir(REAL)
+write_hook(os.path.join(REAL, "hook"), "via-symlink")
+
+# 1. Symlinked drop-in is skipped; the regular drop-in beside it still runs.
+HOOK_DIR = os.path.join(cfg.offline_root, "post_invoke.d")
+make_hook_dir(HOOK_DIR)
+write_hook(os.path.join(HOOK_DIR, "10-ok"), "ok")
+os.symlink(os.path.join(REAL, "hook"), os.path.join(HOOK_DIR, "20-link"))
+use_hook(HOOK_DIR)
+log = cycle()
+if 'via-symlink' in log:
+    opk.fail("symlinked drop-in was executed: %r" % log)
+if log != 'ok\nok\n':
+    opk.fail("trusted drop-in did not run once per transaction: %r" % log)
+
+# 2. A hook directory reached through a symlink is not used.
+LINK_DIR = os.path.join(cfg.offline_root, "linked.d")
+os.symlink(HOOK_DIR, LINK_DIR)
+use_hook(LINK_DIR)
+log = cycle()
+if log != '':
+    opk.fail("hook directory reached via symlink was used: %r" % log)
+
+# 3. A hook directory whose parent another user can write to is not used.
+OPEN_PARENT = os.path.join(cfg.offline_root, "open")
+make_hook_dir(OPEN_PARENT)
+os.chmod(OPEN_PARENT, 0o777)
+UNDER_OPEN = os.path.join(OPEN_PARENT, "post_invoke.d")
+make_hook_dir(UNDER_OPEN)
+write_hook(os.path.join(UNDER_OPEN, "10-swapped"), "swapped")
+use_hook(UNDER_OPEN)
+log = cycle()
+if log != '':
+    opk.fail("hook directory below a world-writable parent was used: %r"
+             % log)
+
+# 4. A single-file hook that is itself a symlink is not run.
+use_hook(os.path.join(HOOK_DIR, "20-link"))
+log = cycle()
+if log != '':
+    opk.fail("symlinked single-file hook was executed: %r" % log)
