+++ b/tests/core/46_post_invoke.py
@@ -0,0 +1,108 @@
+#! /usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Verifies the post_invoke hook:
+#   - runs after a successful, state-changing transaction,
+#   - runs drop-in scripts in lexical order,
+#   - ignores non-executable drop-ins,
+#   - does not run for a --noaction (dry-run) transaction,
+#   - does not run for a no-op transaction,
+#   - does not run for a transaction on an offline root (-o).
+#
+
+import os
+import opk, cfg, opkgcl
+
+opk.regress_init()
+# post_invoke hooks are skipped for offline roots, so drive opkg online.
+opkgcl.use_online_root()
+
+TEST_LOG = os.path.join(cfg.offline_root, "post_invoke_test.log")
+HOOK_DIR = os.path.join(cfg.offline_root, "post_invoke.d")
+
+
+def readFile(path):
+    try:
+        with open(path, 'r') as f:
+            return f.read()
+    except IOError:
+        return ''
+
+
+def rmFile(path):
+    try:
+        os.remove(path)
+    except OSError:
+        pass
+
+
+# Create a drop-in hook directory with two ordered scripts. The scripts are
+# named out of lexical order to prove opkg sorts them before running.
+os.makedirs(HOOK_DIR)
+for name, tag in (('20-second', 'second'), ('10-first', 'first')):
+    path = os.path.join(HOOK_DIR, name)
+    with open(path, 'w') as f:
+        os.fchmod(f.fileno(), 0o755)
+        f.write('\n'.join([
+            '#!/bin/sh',
+            "echo %s >> '%s'" % (tag, TEST_LOG),
+            '',
+        ]))
+
+# A non-executable drop-in must be ignored.
+with open(os.path.join(HOOK_DIR, '30-skip'), 'w') as f:
+    f.write("#!/bin/sh\necho skip >> '%s'\n" % TEST_LOG)
+
+sysconfdir = os.environ['SYSCONFDIR']
+testconfdir = cfg.offline_root + sysconfdir
+with open('%s/opkg/opkg.conf' % testconfdir, 'a') as f:
+    f.write('option post_invoke %s\n' % HOOK_DIR)
+
+o = opk.OpkGroup()
+o.add(Package="a")
+o.write_opk()
+o.write_list()
+opkgcl.update()
+
+# 1. A dry-run install must not fire the hook.
+rmFile(TEST_LOG)
+opkgcl.install("a", flags="--noaction")
+if opkgcl.is_installed("a"):
+    opk.fail("Package 'a' installed during a --noaction transaction.")
+if readFile(TEST_LOG) != '':
+    opk.fail("post_invoke hook ran during a --noaction transaction.")
+
+# 2. A real install fires the hook once, running drop-ins in lexical order.
+rmFile(TEST_LOG)
+opkgcl.install("a")
+if not opkgcl.is_installed("a"):
+    opk.fail("Package 'a' installed but reports as not installed.")
+if readFile(TEST_LOG) != 'first\nsecond\n':
+    opk.fail("post_invoke hook did not run drop-ins in order: %r"
+             % readFile(TEST_LOG))
+
+# 3. A no-op transaction (nothing to do) must not fire the hook.
+rmFile(TEST_LOG)
+opkgcl.install("a")
+if readFile(TEST_LOG) != '':
+    opk.fail("post_invoke hook ran for a no-op transaction.")
+
+# 4. A real remove fires the hook again.
+rmFile(TEST_LOG)
+opkgcl.remove("a")
+if opkgcl.is_installed("a"):
+    opk.fail("Package 'a' removed but still reports as installed.")
+if readFile(TEST_LOG) != 'first\nsecond\n':
+    opk.fail("post_invoke hook did not run after remove: %r"
+             % readFile(TEST_LOG))
+
+# 5. A transaction on an offline root must not fire the running system's hook.
+rmFile(TEST_LOG)
+out = opkgcl.offline_root_cmd("install a")
+if not opkgcl.is_installed("a"):
+    opk.fail("Package 'a' failed to install into the offline root.")
+if readFile(TEST_LOG) != '':
+    opk.fail("post_invoke hook ran for an offline-root transaction: %r"
+             % readFile(TEST_LOG))
+if 'skipping hooks for offline root' not in out:
+    opk.fail("offline-root skip was not reported: %r" % out)
