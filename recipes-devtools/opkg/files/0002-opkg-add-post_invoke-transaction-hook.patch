+/*
+ * Run the post_invoke hook after a successful, state-changing transaction.
+ *
+ * opkg_config->post_invoke may name either a single executable or a directory
+ * of executables (a "drop-in" directory).  Directory entries are run in
+ * lexical order.  A hook that fails is logged but does not change opkg's exit
+ * status, since the transaction itself has already succeeded.
+ */
+/*
+ * A post_invoke hook runs as the (root) opkg process, so opkg must not execute
+ * anything a less-privileged user could substitute. A hook file, and the
+ * directory containing it, are trusted only if they are owned by the user opkg
+ * runs as and are not writable by group or other.
+ */
+extern char **environ;
+
+static int post_invoke_trusted(const char *path, const struct stat *st)
+{
+    if (st->st_uid != geteuid()) {
+        opkg_msg(NOTICE, "post_invoke: %s is not owned by uid %d; skipping.\n",
+                 path, (int)geteuid());
+        return 0;
+    }
+    if (st->st_mode & (S_IWGRP | S_IWOTH)) {
+        opkg_msg(NOTICE,
+                 "post_invoke: %s is group- or world-writable; skipping.\n",
+                 path);
+        return 0;
+    }
+    return 1;
+}
+
+/*
+ * Run one hook, best-effort: log the invocation and any non-zero exit, but do
+ * not change opkg's exit status or retry -- the transaction already succeeded.
+ */
+/* Default seconds a post_invoke hook may run before opkg terminates it;
+ * overridable via the post_invoke_timeout config option. */
+#define POST_INVOKE_DEFAULT_TIMEOUT 300
+/* Internal sentinel from run_hook_timed(): the hook was killed for exceeding
+ * the time limit (distinct from any real exit status). */
+#define POST_INVOKE_TIMED_OUT (-2)
+#define POST_INVOKE_GRACE_MS 5000u
+
+static uint64_t post_invoke_now_ms(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;
+}
+
+/*
+ * Run one hook with a time limit, in its own process group so that a timeout
+ * also reaps any children it spawned. Returns the hook's exit status, -1 on a
+ * fork/wait error, or POST_INVOKE_TIMED_OUT if the hook had to be killed.
+ */
+static int run_hook_timed(int fd, const char *path, unsigned int limit_s)
+{
+    pid_t pid;
+    int status = 0, leader_done = 0, timed_out = 0;
+    uint64_t deadline, grace_end = 0;
+
+    pid = fork();
+    if (pid < 0) {
+        opkg_perror(ERROR, "post_invoke: cannot fork for %s", path);
+        return -1;
+    }
+    if (pid == 0) {
+        char *argv[] = { (char *)path, NULL };
+
+        setpgid(0, 0);
+        /* A #! interpreter reopens the script via /dev/fd, so keep fd open. */
+        fcntl(fd, F_SETFD, 0);
+        fexecve(fd, argv, environ);
+        _exit(127);
+    }
+    setpgid(pid, pid);          /* set in the parent too, to avoid a race */
+    deadline = post_invoke_now_ms() + (uint64_t)limit_s * 1000u;
+
+    for (;;) {
+        struct timespec ts = { 0, 100000000L };     /* 100 ms */
+        uint64_t now;
+        pid_t r;
+
+        if (!leader_done) {
+            r = waitpid(pid, &status, WNOHANG);
+            if (r == pid)
+                leader_done = 1;
+            else if (r < 0 && errno != EINTR) {
+                opkg_perror(ERROR, "post_invoke: waitpid for %s", path);
+                return -1;
+            }
+        }
+
+        if (!timed_out && leader_done)
+            return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+
+        now = post_invoke_now_ms();
+        if (!timed_out && now >= deadline) {
+            opkg_msg(NOTICE,
+                     "post_invoke hook %s exceeded %u s; sending SIGTERM.\n",
+                     path, limit_s);
+            kill(-pid, SIGTERM);
+            timed_out = 1;
+            grace_end = now + POST_INVOKE_GRACE_MS;
+        } else if (timed_out) {
+            int group_exists = kill(-pid, 0) == 0 || errno == EPERM;
+
+            if (!group_exists)
+                break;
+            if (now >= grace_end) {
+                opkg_msg(NOTICE,
+                         "post_invoke hook %s exceeded termination grace; sending SIGKILL.\n",
+                         path);
+                kill(-pid, SIGKILL);
+                if (!leader_done) {
+                    while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+                        ;
+                }
+                return POST_INVOKE_TIMED_OUT;
+            }
+        }
+
+        nanosleep(&ts, NULL);
+    }
+
+    if (timed_out) {
+        if (!leader_done) {
+            while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+                ;
+        }
+        return POST_INVOKE_TIMED_OUT;
+    }
+    if (leader_done && WIFEXITED(status))
+        return WEXITSTATUS(status);
+    return -1;
+}
+
+/*
+ * Run one hook, best-effort: log the invocation and any non-zero exit (or a
+ * timeout), but do not change opkg's exit status or retry -- the transaction
+ * has already succeeded.
+ */
+static void run_post_invoke_hook(int fd, const char *path)
+{
+    int limit = opkg_config->post_invoke_timeout;
+    int rc;
+
+    if (limit <= 0)
+        limit = POST_INVOKE_DEFAULT_TIMEOUT;
+
+    opkg_msg(NOTICE, "Running post_invoke hook %s\n", path);
+    rc = run_hook_timed(fd, path, (unsigned int)limit);
+    if (rc == POST_INVOKE_TIMED_OUT)
+        opkg_msg(NOTICE,
+                 "post_invoke hook %s timed out after %d s (exit code 124).\n",
+                 path, limit);
+    else if (rc != 0)
+        opkg_msg(NOTICE, "post_invoke hook %s exited with status %d.\n",
+                 path, rc);
+}
+
+/*
+ * A directory on the hook's path is safe if no less-privileged user can
+ * rename the entry below it: it is owned by root or us and is either not
+ * group/world-writable, or is sticky and the entry is owned by root or us.
+ */
+static int post_invoke_ancestor_ok(const struct stat *dst,
+                                   const struct stat *cst)
+{
+    uid_t euid = geteuid();
+
+    if (dst->st_uid != 0 && dst->st_uid != euid)
+        return 0;
+    if (!(dst->st_mode & (S_IWGRP | S_IWOTH)))
+        return 1;
+    return (dst->st_mode & S_ISVTX)
+            && (cst->st_uid == 0 || cst->st_uid == euid);
+}
+
+/*
+ * Open an absolute path one component at a time relative to the previous
+ * directory fd, never following symlinks and checking each directory before
+ * descending, so no component can be swapped once it has been validated.
+ * Returns an fd for the final component with its stat in *st and its parent
+ * directory's stat in *pst, or -1.
+ */
+static int post_invoke_open(const char *path, struct stat *st,
+                            struct stat *pst)
+{
+    char *copy, *comp, *next, *save = NULL;
+    int fd, nfd;
+    struct stat cst;
+
+    if (path[0] != '/') {
+        opkg_msg(NOTICE,
+                 "post_invoke: %s is not an absolute path; skipping.\n", path);
+        return -1;
+    }
+
+    fd = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd < 0 || fstat(fd, st) != 0) {
+        opkg_perror(ERROR, "post_invoke: cannot open /");
+        if (fd >= 0)
+            close(fd);
+        return -1;
+    }
+    if ((st->st_uid != 0 && st->st_uid != geteuid())
+            || (st->st_mode & (S_IWGRP | S_IWOTH))) {
+        opkg_msg(NOTICE, "post_invoke: / is not trusted; skipping %s.\n",
+                 path);
+        close(fd);
+        return -1;
+    }
+    *pst = *st;
+
+    copy = xstrdup(path);
+    for (comp = strtok_r(copy, "/", &save); comp; comp = next) {
+        next = strtok_r(NULL, "/", &save);
+        if (strcmp(comp, ".") == 0)
+            continue;
+        if (strcmp(comp, "..") == 0) {
+            opkg_msg(NOTICE, "post_invoke: %s contains '..'; skipping.\n",
+                     path);
+            goto fail;
+        }
+        /* O_NONBLOCK keeps a FIFO planted as a hook from stalling opkg. */
+        nfd = openat(fd, comp, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC
+                     | (next ? O_DIRECTORY : 0));
+        if (nfd < 0) {
+            if (errno == ENOENT)
+                opkg_msg(NOTICE, "post_invoke hook %s not found; skipping.\n",
+                         path);
+            else
+                opkg_msg(NOTICE,
+                         "post_invoke: cannot open %s: %s (symlinks are not followed); skipping.\n",
+                         path, strerror(errno));
+            goto fail;
+        }
+        if (fstat(nfd, &cst) != 0 || !post_invoke_ancestor_ok(st, &cst)) {
+            opkg_msg(NOTICE,
+                     "post_invoke: a directory on the path to %s is writable by another user; skipping.\n",
+                     path);
+            close(nfd);
+            goto fail;
+        }
+        close(fd);
+        fd = nfd;
+        *pst = *st;
+        *st = cst;
+    }
+    free(copy);
+    return fd;
+
+ fail:
+    close(fd);
+    free(copy);
+    return -1;
+}
+
+static int post_invoke_name_cmp(const void *a, const void *b)
+{
+    return strcoll(*(char *const *)a, *(char *const *)b);
+}
+
+static void run_post_invoke_dir(int dfd, const char *hook)
+{
+    DIR *d;
+    const struct dirent *de;
+    char **names = NULL;
+    size_t n = 0, i;
+    int lfd;
+
+    lfd = dup(dfd);
+    d = lfd < 0 ? NULL : fdopendir(lfd);
+    if (!d) {
+        opkg_perror(ERROR, "Failed to scan post_invoke dir %s", hook);
+        if (lfd >= 0)
+            close(lfd);
+        return;
+    }
+    while ((de = readdir(d)) != NULL) {
+        if (de->d_name[0] == '.')
+            continue;
+        names = xrealloc(names, (n + 1) * sizeof(*names));
+        names[n++] = xstrdup(de->d_name);
+    }
+    closedir(d);
+    if (n == 0)
+        return;
+    qsort(names, n, sizeof(*names), post_invoke_name_cmp);
+
+    for (i = 0; i < n; i++) {
+        char *path;
+        struct stat est;
+        int hfd;
+
+        sprintf_alloc(&path, "%s/%s", hook, names[i]);
+        hfd = openat(dfd, names[i],
+                     O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+        if (hfd < 0) {
+            if (errno == ELOOP)
+                opkg_msg(NOTICE,
+                         "post_invoke: %s is a symbolic link; skipping.\n",
+                         path);
+        } else {
+            if (fstat(hfd, &est) == 0 && S_ISREG(est.st_mode)
+                    && (est.st_mode & S_IXUSR)
+                    && post_invoke_trusted(path, &est))
+                run_post_invoke_hook(hfd, path);
+            close(hfd);
+        }
+        free(path);
+        free(names[i]);
+    }
+    free(names);
+}
+
+static void run_post_invoke(void)
+{
+    const char *hook = opkg_config->post_invoke;
+    const char *root = opkg_config->offline_root;
+    struct stat st, pst;
+    int fd;
+
+    if (!hook || !hook[0])
+        return;
+
+    /* Hooks act on the running system, and running them from another root
+     * would execute that root's files on this host, so skip them. */
+    if (root && root[0]) {
+        char *real = realpath(root, NULL);
+        int is_host_root = real && strcmp(real, "/") == 0;
+
+        free(real);
+        if (!is_host_root) {
+            opkg_msg(NOTICE,
+                     "post_invoke: skipping hooks for offline root %s.\n", root);
+            return;
+        }
+    }
+
+    fd = post_invoke_open(hook, &st, &pst);
+    if (fd < 0)
+        return;
+
+    if (S_ISDIR(st.st_mode)) {
+        /* The drop-in directory must be trusted: if a less-privileged user can
+         * write to it, they can add or replace the executables opkg runs. */
+        if (post_invoke_trusted(hook, &st))
+            run_post_invoke_dir(fd, hook);
+    } else if (S_ISREG(st.st_mode) && (st.st_mode & S_IXUSR)) {
+        /* Single-file hook: both the file and its directory must be trusted. */
+        char *dir = xstrdup(hook);
+        char *slash = strrchr(dir, '/');
+
+        if (slash == dir)
+            dir[1] = '\0';
+        else
+            *slash = '\0';
+        if (post_invoke_trusted(dir, &pst) && post_invoke_trusted(hook, &st))
+            run_post_invoke_hook(fd, hook);
+        free(dir);
+    } else {
+        opkg_msg(NOTICE, "post_invoke hook %s is not executable; skipping.\n",
+                 hook);
+    }
+    close(fd);
+}
+
 int main(int argc, char *argv[])
 {
     int opts, err = -1;
@@ -542,6 +924,11 @@ int main(int argc, char *argv[])
 
     err = opkg_cmd_exec(cmd, argc - opts, (const char **)(argv + opts));
 
