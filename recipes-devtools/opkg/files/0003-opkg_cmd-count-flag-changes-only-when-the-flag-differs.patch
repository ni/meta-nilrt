diff --git a/tests/core/50_post_invoke_flag.py b/tests/core/50_post_invoke_flag.py
new file mode 100644
index 0000000..4bdde53
--- /dev/null
+++ b/tests/core/50_post_invoke_flag.py
@@ -0,0 +1,79 @@
+#! /usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Verifies that `opkg flag` fires the post_invoke hook only when it actually
+# changes a package's flag or status, not when it re-applies the current one.
+#
+
+import os
+import opk, cfg, opkgcl
+
+opk.regress_init()
+# post_invoke hooks are skipped for offline roots, so drive opkg online.
+opkgcl.use_online_root()
+
+TEST_LOG = os.path.join(cfg.offline_root, "post_invoke_flag.log")
+HOOK_DIR = os.path.join(cfg.offline_root, "post_invoke.d")
+
+
+def readFile(path):
+    try:
+        with open(path, 'r') as f:
+            return f.read()
+    except IOError:
+        return ''
+
+
+def rmFile(path):
+    try:
+        os.remove(path)
+    except OSError:
+        pass
+
+
+os.makedirs(HOOK_DIR)
+os.chmod(HOOK_DIR, 0o755)
+hook = os.path.join(HOOK_DIR, "10-log")
+with open(hook, 'w') as f:
+    f.write("#!/bin/sh\necho ran >> '%s'\n" % TEST_LOG)
+os.chmod(hook, 0o755)
+
+sysconfdir = os.environ['SYSCONFDIR']
+with open('%s/opkg/opkg.conf' % (cfg.offline_root + sysconfdir), 'a') as f:
+    f.write('option post_invoke %s\n' % HOOK_DIR)
+
+o = opk.OpkGroup()
+o.add(Package="a")
+o.write_opk()
+o.write_list()
+opkgcl.update()
+opkgcl.install("a")
+if not opkgcl.is_installed("a"):
+    opk.fail("Package 'a' failed to install.")
+
+# 1. Setting a new flag is a state change and fires the hook.
+rmFile(TEST_LOG)
+opkgcl.opkgcl("flag hold a")
+if readFile(TEST_LOG) != 'ran\n':
+    opk.fail("hook did not run when 'flag hold' changed the flag: %r"
+             % readFile(TEST_LOG))
+
+# 2. Re-applying the same flag is a no-op and must not fire the hook.
+rmFile(TEST_LOG)
+opkgcl.opkgcl("flag hold a")
+if readFile(TEST_LOG) != '':
+    opk.fail("hook ran for a no-op 'flag hold': %r" % readFile(TEST_LOG))
+
+# 3. Same for status flags: re-applying 'installed' is a no-op.
+rmFile(TEST_LOG)
+opkgcl.opkgcl("flag installed a")
+if readFile(TEST_LOG) != '':
+    opk.fail("hook ran for a no-op 'flag installed': %r"
+             % readFile(TEST_LOG))
+
+# 4. Changing the status flag is a state change and fires the hook.
+rmFile(TEST_LOG)
+opkgcl.opkgcl("flag unpacked a")
+if readFile(TEST_LOG) != 'ran\n':
+    opk.fail("hook did not run when 'flag unpacked' changed the status: %r"
+             % readFile(TEST_LOG))
