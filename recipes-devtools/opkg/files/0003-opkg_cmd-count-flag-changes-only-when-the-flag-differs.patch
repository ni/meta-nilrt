From fd259435d118426c10578ac8d529233ba6e58015 Mon Sep 17 00:00:00 2001
From: vairamani muthusamy <vairamani.muthusamy@emerson.com>
Date: Wed, 30 Sep 2026 04:26:17 +0530
Subject: opkg_cmd: count flag changes only when the flag
 differs

opkg_flag_cmd() incremented opkg_state_changed for every package it was
given, even when the requested flag or status was already set. That made
a no-op "opkg flag" look like a state change: the status file was
rewritten and the post_invoke hook fired although nothing changed.

Compare the requested state flag or status with the package's current
value and only count the package as changed when it differs.

Add a core test checking that the hook fires for a real flag or status
change and not when the same flag or status is applied again.

Upstream-Status: Submitted [https://lists.yoctoproject.org/g/opkg/message/230]

AI-Generated: Claude Opus 4.8
Signed-off-by: vairamani muthusamy <vairamani.muthusamy@emerson.com>
---
 libopkg/opkg_cmd.c                | 19 ++++++--
 tests/Makefile                    |  1 +
 tests/core/50_post_invoke_flag.py | 79 +++++++++++++++++++++++++++++++
 3 files changed, 96 insertions(+), 3 deletions(-)
 create mode 100644 tests/core/50_post_invoke_flag.py

diff --git a/libopkg/opkg_cmd.c b/libopkg/opkg_cmd.c
index c6089f1..b2bacd3 100644
--- a/libopkg/opkg_cmd.c
+++ b/libopkg/opkg_cmd.c
@@ -830,6 +830,8 @@ static int opkg_flag_cmd(int argc, char **argv)
     signal(SIGINT, sigint_handler);
 
     for (i = 1; i < argc; i++) {
+        int changed = 0;
+
         if (opkg_config->restrict_to_default_dest) {
             pkg = pkg_hash_fetch_installed_by_name_dest(argv[i],
                     opkg_config->default_dest);
@@ -843,7 +845,12 @@ static int opkg_flag_cmd(int argc, char **argv)
         }
 
         if (is_state_flag) {
-            pkg->state_flag = pkg_state_flag_from_str(flags);
+            pkg_state_flag_t flag = pkg_state_flag_from_str(flags);
+
+            if (pkg->state_flag != flag) {
+                pkg->state_flag = flag;
+                changed = 1;
+            }
         }
 
         /*
@@ -851,10 +858,16 @@ static int opkg_flag_cmd(int argc, char **argv)
          * should be configured by opkg configure at a later date.
          */
         if (is_state_status_flag) {
-            pkg->state_status = pkg_state_status_from_str(flags);
+            pkg_state_status_t status = pkg_state_status_from_str(flags);
+
+            if (pkg->state_status != status) {
+                pkg->state_status = status;
+                changed = 1;
+            }
         }
 
-        opkg_state_changed++;
+        if (changed)
+            opkg_state_changed++;
         opkg_msg(NOTICE, "Setting flags for package %s to %s.\n", pkg->name,
                  flags);
     }
