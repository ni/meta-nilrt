#!/bin/sh
### BEGIN INIT INFO
# Provides:          aide-init
# Required-Start:    $local_fs $remote_fs $syslog
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Build and update the AIDE baseline database
# Description:       On the first boot after provisioning (when no baseline
#                    database exists yet), build the AIDE file-integrity
#                    baseline. The 'reinit' action (run by the opkg
#                    post_invoke hook after package changes) rebuilds it in
#                    the background, reporting first what changed since the
#                    previous baseline. A rebuild cut short by a reboot is
#                    redone at boot.
### END INIT INFO

# The init environment does not guarantee a usable PATH; set one explicitly so
# aide and sha256sum resolve during first-boot baseline creation.
PATH=/usr/sbin:/usr/bin:/sbin:/bin

DBDIR=/var/lib/aide
DB=$DBDIR/aide.db.gz
NEWDB=$DBDIR/aide.db.new.gz
LOGDIR=/var/log/aide
LOCK=/run/aide-init.lock
# Held by aide-check while it scans, and by a rebuild: aide locks its report
# file, so a rebuild overlapping a check would fail.
CHECKLOCK=/run/aide-check.lock
# A rebuild request. A build renames it to RUNNING when it starts and removes
# RUNNING when it ends, so a build cut short (reboot, power loss) is redone.
# aide-check skips while either exists.
PENDING=$DBDIR/rebuild.pending
RUNNING=$DBDIR/rebuild.running
# Its mtime is when the scan of the active baseline started.
SCANNED=$DBDIR/baseline.scanned
# Paths owned by packages when that scan started (gzip).
OWNED=$DBDIR/baseline.owned.gz
OPKG_INFO=/var/lib/opkg/info

# The baseline, its checksum and the reports can expose scanned paths/hashes ->
# keep everything created here root-only.
umask 077

baseline_verified() {
	sum=$(sha256sum "$DB" 2>/dev/null)
	sum=${sum%% *}
	[ -n "$sum" ] && [ "$(cat "$DB.sha256" 2>/dev/null)" = "$sum" ]
}

# Log what changed since the previous baseline ($1 = aide --update report) and
# list in the report what opkg does not account for: added or changed paths not
# in a package installed or upgraded since that baseline, and removed paths
# that no package owned at that baseline or that a package still owns.
report_changes() {
	counts=$(grep -E "^ *(Added|Removed|Changed) entries:[[:space:]]+[0-9]+" "$1" | tr -s ' ' | tr '\n' ' ')
	since=$SCANNED
	[ -f "$since" ] || since=$DB
	other=$(
		{
			find "$OPKG_INFO" -name '*.list' -newer "$since" -exec cut -f1 {} + | sed 's/^/R /'
			find "$OPKG_INFO" -name '*.list' -exec cut -f1 {} + | sed 's/^/A /'
			gzip -dc "$OWNED" | sed 's/^/B /'
			sed 's/^/P /' "$1"
		} 2>/dev/null | awk '
			{ t = $1; l = substr($0, 3) }
			t == "R" { recent[l] = 1; next }
			t == "A" { owned[l] = 1; next }
			t == "B" { before[l] = 1; next }
			l ~ /^(Added|Removed|Changed) entries:$/ { split(l, w, " "); sec = w[1]; next }
			l ~ /^(Detailed information|The attributes)/ { sec = "" }
			sec == "" || (i = index(l, ": /")) == 0 { next }
			{
				p = substr(l, i + 2)
				if (sec != "Changed") {
					d = p; sub(/\/[^\/]*$/, "", d)
					touched[d == "" ? "/" : d] = 1
				}
				if (sec == "Removed") ok = (p in before) && !(p in owned); else ok = (p in recent)
				if (ok) next
				n++; ent[n] = tolower(sec) " " p; path[n] = p
				# Change flags follow the type; drop the first one, the size.
				f = substr(l, 2, i - 2); f = substr(f, 1, 1) substr(f, 3)
				dir[n] = (sec == "Changed" && substr(l, 1, 1) == "d" && f ~ /^[ .]*$/)
			}
			# Adding or removing entries changes only the size of their directory;
			# those entries are judged on their own.
			END { for (k = 1; k <= n; k++) if (!(dir[k] && (path[k] in touched))) print ent[k] }'
	)
	if [ -z "$other" ]; then
		logger -t aide-init -p daemon.info "rebaseline: changes since the previous baseline are from opkg packages: ${counts:-none} [report: $1]"
		return
	fi
	n=$(printf '%s\n' "$other" | wc -l)
	printf '\nNot accounted for by opkg packages:\n%s\n' "$other" >> "$1"
	logger -t aide-init -p daemon.warning "rebaseline: $n change(s) since the previous baseline not accounted for by opkg packages, e.g. $(printf '%s\n' "$other" | head -n 3 | tr '\n' ';') [report: $1]"
}

# Install $NEWDB and its checksum as the active baseline and make both
# immutable, so neither can be rewritten to defeat the tamper check. A failure
# (or power loss) between the two renames leaves a mismatched pair: aide-check
# refuses it, and the next rebuild replaces it.
promote_baseline() {
	sum=$(sha256sum "$NEWDB" 2>/dev/null)
	sum=${sum%% *}
	command -v chattr >/dev/null 2>&1 && chattr -i "$DB" "$DB.sha256" 2>/dev/null
	if [ -z "$sum" ] || ! printf '%s\n' "$sum" > "$DB.sha256.new"; then
		logger -t aide-init -p daemon.err "failed to write the checksum of $NEWDB; keeping previous baseline"
		rm -f "$NEWDB" "$DB.sha256.new"
	elif ! mv -f "$NEWDB" "$DB"; then
		logger -t aide-init -p daemon.err "failed to promote baseline DB ($NEWDB -> $DB); keeping previous baseline"
		rm -f "$NEWDB" "$DB.sha256.new"
	elif ! mv -f "$DB.sha256.new" "$DB.sha256"; then
		logger -t aide-init -p daemon.crit "baseline DB replaced but $DB.sha256 could not be updated; aide-check will refuse - run '/etc/init.d/aide-init reinit'"
		rm -f "$DB.sha256.new"
	else
		chmod 600 "$DB" "$DB.sha256"
		mv -f "$SCANNED.new" "$SCANNED"
		mv -f "$OWNED.new" "$OWNED"
		logger -t aide-init -p daemon.notice "AIDE baseline created: $DB sha256=$sum"
	fi
	if [ -f "$DB" ] && [ -f "$DB.sha256" ] && command -v chattr >/dev/null 2>&1 &&
			! chattr +i "$DB" "$DB.sha256" 2>/dev/null; then
		logger -t aide-init -p daemon.warning "failed to make baseline DB/checksum immutable (chattr +i); baseline protection is reduced"
	fi
	sync
}

# Scan and install a new baseline (both locks held). The previous baseline
# stays active until then. With a verified previous baseline, aide --update
# reports what changed since it in the same scan.
build_once() {
	rm -f "$NEWDB" "$SCANNED.new"
	: > "$SCANNED.new"
	find "$OPKG_INFO" -name '*.list' -exec cut -f1 {} + 2>/dev/null | gzip -c > "$OWNED.new"
	if baseline_verified; then
		mode=update
		report="$LOGDIR/aide-update.$(date +%Y%m%d-%H%M%S).log"
	else
		mode=init
		report="$LOGDIR/aide-init.log"
		if [ -f "$DB" ] || [ -f "$DB.sha256" ]; then
			logger -t aide-init -p daemon.crit "previous baseline is missing or fails its checksum; building a new one without reporting changes since it"
		fi
	fi
	aide --"$mode" > "$report" 2>&1
	rc=$?
	# aide --update exits 1-7 when it found differences (new|removed|changed).
	if [ "$rc" -ne 0 ] && { [ "$mode" = init ] || [ "$rc" -gt 7 ]; }; then
		logger -t aide-init -p daemon.err "AIDE --$mode failed (exit $rc); keeping previous baseline; see $report"
		rm -f "$NEWDB"
	elif [ ! -f "$NEWDB" ]; then
		logger -t aide-init -p daemon.err "AIDE --$mode produced no database ($NEWDB missing); keeping previous baseline; see $report"
	else
		[ "$mode" = init ] || report_changes "$report"
		promote_baseline
	fi
	# Bound retained reports so /var/log/aide cannot grow without limit.
	ls -1t "$LOGDIR"/aide-update.*.log 2>/dev/null | tail -n +31 | while read -r old; do
		rm -f "$old"
	done
}

# Serve rebuild requests until none is left. Runs in the background with the
# init lock held on fd 9; aide inherits both locks, so a build whose shell is
# killed still keeps checks out until aide exits.
run_builds() {
	# Ensure the working directories exist AND are root-only (reports/baseline
	# metadata can expose scanned paths/hashes). chmod enforces the mode even if
	# a directory pre-existed with broader permissions.
	if ! mkdir -p "$DBDIR" "$LOGDIR" 2>/dev/null || ! chmod 700 "$DBDIR" "$LOGDIR" 2>/dev/null; then
		# Kept, the request would make every aide-check skip.
		logger -t aide-init -p daemon.err "cannot create or secure $DBDIR or $LOGDIR; baseline rebuild skipped"
		rm -f "$PENDING" "$RUNNING"
		exit 0
	fi
	# Wait for a running aide-check, and keep checks out until the new baseline
	# is in place.
	if ! { exec 8>>"$CHECKLOCK"; } 2>/dev/null || ! flock 8; then
		logger -t aide-init -p daemon.err "cannot lock $CHECKLOCK; baseline rebuild postponed"
		exit 0
	fi
	while :; do
		while [ -f "$PENDING" ] || [ -f "$RUNNING" ]; do
			# Requests made from here on are served by the next scan.
			if [ -f "$PENDING" ] && ! mv -f "$PENDING" "$RUNNING"; then
				break 2
			fi
			sync
			build_once
			rm -f "$RUNNING" || break 2
		done
		# A request made after the test above found the lock busy: take the
		# lock back and serve it.
		flock -u 9
		if [ -f "$PENDING" ] && flock -n 9; then
			continue
		fi
		break
	done
	sync
}

# Record a rebuild request and start a background build, unless one is running:
# it serves the request after its current scan.
request_rebuild() {
	# Secure the directory before writing in it, and never write through a link.
	if ! { mkdir -p "$DBDIR" && chmod 700 "$DBDIR" && { [ ! -L "$PENDING" ] || rm -f "$PENDING"; } &&
			: >> "$PENDING" && sync; } 2>/dev/null; then
		logger -t aide-init -p daemon.err "cannot record rebuild request $PENDING; baseline rebuild skipped"
		return 0
	fi
	if ! exec 9>>"$LOCK" 2>/dev/null; then
		logger -t aide-init -p daemon.err "cannot open lock file $LOCK; baseline rebuild left to the next aide-check or boot"
		return 0
	fi
	flock -n 9; _rc=$?
	if [ "$_rc" -eq 1 ]; then
		logger -t aide-init -p daemon.info "baseline build already in progress; rebuild queued"
	elif [ "$_rc" -ne 0 ]; then
		logger -t aide-init -p daemon.err "flock failed on $LOCK (rc=$_rc); baseline rebuild left to the next aide-check or boot"
	else
		logger -t aide-init -p daemon.info "building AIDE baseline database in background"
		# Run in the background so a scan does not block boot or opkg.
		run_builds &
	fi
	exec 9>&-
}

case "$1" in
	start)
		# Serve a rebuild requested or cut short before this boot, or build the
		# first baseline. If the DB exists without its checksum, the baseline
		# cannot be verified (aide-check will refuse) -> surface it at boot.
		if [ -f "$PENDING" ] || [ -f "$RUNNING" ] || [ ! -f "$DB" ]; then
			request_rebuild
		elif [ ! -f "$DB.sha256" ]; then
			logger -t aide-init -p daemon.warning "baseline DB present but checksum $DB.sha256 missing; aide-check will refuse - run '/etc/init.d/aide-init reinit'"
		fi
		;;
	reinit|force-reinit)
		# Rebuild the baseline from the current filesystem state (after a
		# legitimate update, or to recover from a failed/tampered baseline).
		request_rebuild
		;;
	stop|restart|force-reload|status)
		;;
	*)
		echo "Usage: $0 {start|reinit|force-reinit|stop|restart|force-reload|status}" >&2
		exit 1
		;;
esac
exit 0
